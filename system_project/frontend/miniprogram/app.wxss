/* 全局样式重置 */
page {
  background-color: #F5F7FA;
  font-size: 28rpx;
  color: #303133;
  height: 100%;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 容器样式 - 统一留白 */
.container {
  width: 100%;
  min-height: 100vh;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

/* Flex 容器 - 居中对齐 */
.flex-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 卡片样式 - 核心美化 */
.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  width: calc(100% - 32rpx);
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.card:active {
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transform: translateY(-2rpx);
}

/* 按钮样式 - 统一风格 */
.btn {
  background-color: #409EFF;
  color: #FFFFFF;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  margin: 16rpx 0;
  font-size: 30rpx;
  transition: all 0.2s ease;
}

.btn:active {
  background-color: #337ECC;
  transform: scale(0.98);
}

.btn-block {
  display: block;
  width: 100%;
}

.btn-primary {
  background-color: #409EFF;
}

.btn-success {
  background-color: #67C23A;
}

.btn-warning {
  background-color: #E6A23C;
}

.btn-danger {
  background-color: #F56C6C;
}

.btn-light {
  background-color: #F5F7FA;
  color: #606266;
}

/* 文字颜色 - 语义化 */
.text-primary { color: #409EFF; }
.text-success { color: #67C23A; }
.text-warning { color: #E6A23C; }
.text-danger { color: #F56C6C; }
.text-muted { color: #909399; }
.text-dark { color: #303133; }
.text-light { color: #FFFFFF; }

/* 间距类 - 统一管理 */
.m-0 { margin: 0; }
.m-10 { margin: 10rpx; }
.m-20 { margin: 20rpx; }

.mt-10 { margin-top: 10rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-24 { margin-top: 24rpx; }

.mb-10 { margin-bottom: 10rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-20 { margin-bottom: 20rpx; }

.ml-10 { margin-left: 10rpx; }
.ml-16 { margin-left: 16rpx; }

.mr-10 { margin-right: 10rpx; }
.mr-16 { margin-right: 16rpx; }

.p-10 { padding: 10rpx; }
.p-16 { padding: 16rpx; }
.p-20 { padding: 20rpx; }

/* Flex 布局类 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }

.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.items-end { align-items: flex-end; }

.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-around { justify-content: space-around; }

.flex-1 { flex: 1; }

/* 板块标题 - 统一样式 */
.section-title {
  width: calc(100% - 32rpx);
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 24rpx 16rpx 16rpx;
}

.section-title .title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
}

.section-title .more-text {
  font-size: 26rpx;
  color: #409EFF;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
}

.section-title .more-text:active {
  background-color: #ECF5FF;
}

/* 空状态 - 美化 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #909399;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
}

/* 价格样式 - 突出显示 */
.price {
  color: #F56C6C;
  font-weight: 600;
}

.price-large {
  font-size: 36rpx;
}

.price-original {
  color: #909399;
  text-decoration: line-through;
  font-size: 24rpx;
  margin-left: 8rpx;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tag-primary {
  background-color: #ECF5FF;
  color: #409EFF;
}

.tag-success {
  background-color: #F0F9EB;
  color: #67C23A;
}

.tag-warning {
  background-color: #FEF0E6;
  color: #E6A23C;
}

.tag-danger {
  background-color: #FEE2E2;
  color: #F56C6C;
}

/* 表单样式 */
.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.form-item .label {
  width: 120rpx;
  font-size: 28rpx;
  color: #303133;
}

.form-item .input {
  flex: 1;
  font-size: 28rpx;
  padding: 16rpx;
  background-color: #F5F7FA;
  border-radius: 12rpx;
}

.form-item .textarea {
  flex: 1;
  font-size: 28rpx;
  padding: 16rpx;
  background-color: #F5F7FA;
  border-radius: 12rpx;
  min-height: 120rpx;
  line-height: 1.6;
}

/* 下拉刷新样式 */
page[descendant="pull-down-refresh"] {
  background-color: #F5F7FA;
}