/* list.wxss - 现代化资讯列表样式 */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%);
}

/* 顶部标题栏 */
.page-header {
  padding: 40rpx 30rpx 30rpx;
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
  color: #303133;
}

.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 分类筛选 */
.category-scroll {
  background-color: white;
  padding: 24rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  position: sticky;
  top: 0;
  z-index: 100;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
}

.category-item {
  display: inline-flex;
  align-items: center;
  padding: 0 28rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: #f0f9ff;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  border: 2rpx solid #d0f0ff;
}

.category-item.active {
  background: #409eff;
  border-color: #409eff;
}

.category-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #606266;
  position: relative;
  z-index: 1;
  transition: color 0.3s ease;
}

.category-item.active .category-text {
  color: white;
}

.category-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #606266;
  position: relative;
  z-index: 1;
  transition: color 0.3s ease;
}

.category-item.active .category-text {
  color: white;
}

/* 资讯列表滚动区 */
.news-scroll {
  height: calc(100vh - 240rpx);
}

.news-list {
  padding: 24rpx 24rpx 100rpx;
}

/* 资讯卡片 */
.news-card {
  background: white;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.news-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}

/* 封面图区域 */
.news-cover-wrapper {
  position: relative;
  width: 100%;
  height: 400rpx;
  overflow: hidden;
}

.news-cover {
  width: 100%;
  height: 100%;
  transition: transform 0.3s ease;
}

.news-card:active .news-cover {
  transform: scale(1.05);
}

.cover-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, transparent 40%, transparent 60%, rgba(0, 0, 0, 0.4) 100%);
  display: flex;
  align-items: flex-end;
  padding: 20rpx;
}

.category-tag {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #409eff;
  font-weight: 600;
}

/* 内容区域 */
.news-info {
  padding: 24rpx;
}

.news-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #303133;
  line-height: 1.5;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.news-subtitle {
  display: block;
  font-size: 26rpx;
  color: #909399;
  line-height: 1.6;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* 底部信息 */
.news-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.author-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.author-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
}

.author-name {
  font-size: 24rpx;
  color: #606266;
}

.news-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stat-item {
  font-size: 22rpx;
  color: #909399;
}

/* 加载状态 */
.loading-more,
.no-more {
  padding: 40rpx 0;
  text-align: center;
}

.loading-text,
.no-more-text {
  font-size: 26rpx;
  color: #909399;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: #909399;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #c0c4cc;
}