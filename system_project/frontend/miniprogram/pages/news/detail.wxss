/* detail.wxss - 现代化资讯详情样式 */
.page-container {
  min-height: 100vh;
  background: #f8f9fa;
  padding-bottom: 120rpx;
}

/* 封面区域 */
.cover-section {
  position: relative;
  width: 100%;
  height: 500rpx;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.4) 0%, transparent 30%, transparent 70%, rgba(0, 0, 0, 0.3) 100%);
}

.back-btn {
  position: absolute;
  top: 40rpx;
  left: 24rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.back-icon {
  font-size: 36rpx;
  color: #303133;
  font-weight: bold;
}

/* 内容区域 */
.content-wrapper {
  background: white;
  border-radius: 32rpx 32rpx 0 0;
  margin-top: -40rpx;
  position: relative;
  z-index: 10;
  padding: 32rpx 24rpx;
}

/* 标题区域 */
.article-header {
  margin-bottom: 32rpx;
}

.article-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #303133;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.article-subtitle {
  display: block;
  font-size: 28rpx;
  color: #606266;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* 作者信息 */
.meta-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e8ebf0 100%);
  border-radius: 16rpx;
}

.author-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.author-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: 3rpx solid white;
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
}

.author-detail {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.author-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
}

.publish-time {
  font-size: 22rpx;
  color: #909399;
}

.stats-section {
  display: flex;
  gap: 24rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  font-size: 28rpx;
}

.stat-text {
  font-size: 24rpx;
  color: #606266;
  font-weight: 500;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #e4e7ed 50%, transparent 100%);
  margin: 32rpx 0;
}

/* 正文内容 */
.article-content {
  margin-bottom: 32rpx;
}

.rich-text {
  font-size: 30rpx;
  line-height: 2;
  color: #303133;
  word-break: break-all;
}

/*正文样式优化 */
.rich-text p {
  margin-bottom: 24rpx;
}

.rich-text img {
  max-width: 100%;
  border-radius: 12rpx;
  margin: 24rpx 0;
}

.rich-text h1,
.rich-text h2,
.rich-text h3 {
  margin: 32rpx 0 16rpx;
  font-weight: bold;
  color: #303133;
}

/* 标签区域 */
.tags-section {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.tag {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #f0f4ff 0%, #e6eeff 100%);
  border-radius: 20rpx;
  border: 1rpx solid #d4e4ff;
}

.tag-text {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 500;
}

/* 相关推荐 */
.recommend-section {
  margin-top: 24rpx;
  padding: 24rpx;
  background: white;
  border-radius: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #303133;
  position: relative;
  padding-left: 16rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  border-radius: 3rpx;
}

.section-more {
  font-size: 24rpx;
  color: #909399;
}

.recommend-scroll {
  white-space: nowrap;
}

.recommend-list {
  display: inline-flex;
  gap: 16rpx;
}

.recommend-card {
  display: inline-block;
  width: 280rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  overflow: hidden;
  transition: all 0.3s ease;
}

.recommend-card:active {
  transform: scale(0.95);
}

.recommend-cover {
  width: 100%;
  height: 200rpx;
}

.recommend-info {
  padding: 16rpx;
}

.recommend-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #303133;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.recommend-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #909399;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: white;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
}

.action-left {
  display: flex;
  gap: 32rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.action-icon {
  font-size: 36rpx;
}

.action-text {
  font-size: 20rpx;
  color: #606266;
}

.primary-btn {
  padding: 0 48rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
}

.primary-text {
  font-size: 28rpx;
  color: white;
  font-weight: 600;
}