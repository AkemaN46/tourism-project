<view class="page-container">
  <!-- 顶部标题栏 -->
  <view class="page-header">
    <text class="header-title">旅游资讯</text>
    <text class="header-subtitle">发现更多精彩内容</text>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}">
    <view class="category-list">
      <view class="category-item {{currentCategory === '1' ? 'active' : ''}}" bindtap="switchCategory" data-id="1">
        <text class="category-text">景点推荐</text>
      </view>
      <view class="category-item {{currentCategory === '2' ? 'active' : ''}}" bindtap="switchCategory" data-id="2">
        <text class="category-text">美食指南</text>
      </view>
      <view class="category-item {{currentCategory === '3' ? 'active' : ''}}" bindtap="switchCategory" data-id="3">
        <text class="category-text">民宿攻略</text>
      </view>
      <view class="category-item {{currentCategory === '4' ? 'active' : ''}}" bindtap="switchCategory" data-id="4">
        <text class="category-text">活动资讯</text>
      </view>
    </view>
  </scroll-view>

  <!-- 资讯列表 -->
  <scroll-view class="news-scroll" scroll-y enable-flex>
    <view class="news-list">
      <view class="news-card" wx:for="{{newsList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <!-- 大图封面 -->
        <view class="news-cover-wrapper">
          <image src="{{item.coverImage}}" class="news-cover" mode="aspectFill"></image>
          <view class="cover-overlay">
            <view class="category-tag">{{item.categoryName || '资讯'}}</view>
          </view>
        </view>
        
        <!-- 内容区域 -->
        <view class="news-info">
          <text class="news-title">{{item.title}}</text>
          <text class="news-subtitle">{{item.subtitle}}</text>
          
          <view class="news-footer">
            <view class="author-info">
              <image src="/assets/icons/user.png" class="author-avatar"></image>
              <text class="author-name">{{item.author || '匿名'}}</text>
            </view>
            <view class="news-stats">
              <text class="stat-item">{{item.viewCount || 0}} 浏览</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 加载状态 -->
    <view class="loading-more" wx:if="{{loading}}">
      <text class="loading-text">加载中...</text>
    </view>
    
    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && newsList.length > 0}}">
      <text class="no-more-text">没有更多了</text>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{newsList.length === 0 && !loading}}">
      <image src="/assets/icons/empty.png" class="empty-icon"></image>
      <text class="empty-text">暂无资讯内容</text>
      <text class="empty-hint">换个分类试试吧~</text>
    </view>
  </scroll-view>
</view>