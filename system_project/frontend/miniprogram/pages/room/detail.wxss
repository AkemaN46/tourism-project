/* detail.wxss */
.container {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.room-swiper {
  height: 450rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* 房型基本信息卡片 */
.room-basic {
  margin: 20rpx;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.room-basic .room-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.room-basic .room-title {
  flex: 1;
}

.room-basic .room-name {
  font-size: 38rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 16rpx;
  display: block;
}

/* 固定顶部导航 */
.tab-navigation-sticky {
  position: sticky;
  top: 0;
  z-index: 1000;
  margin: 20rpx 20rpx 0;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

/* 标签导航 */
.tab-nav {
  position: relative;
  display: flex;
  height: 100rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #eef2f7 100%);
  border-bottom: 1rpx solid #f0f0f0;
}

/* 标签项 */
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  position: relative;
  z-index: 2;
  transition: all 0.3s ease;
}

.tab-item:active {
  transform: scale(0.95);
  background-color: rgba(64, 158, 255, 0.1);
}

.tab-icon {
  font-size: 32rpx;
  margin-bottom: 6rpx;
  transition: all 0.3s ease;
}

.tab-text {
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s ease;
}

/* 激活状态 */
.tab-item.active {
  color: #409EFF;
}

.tab-item.active .tab-icon {
  transform: scale(1.1);
  color: #409EFF;
}

.tab-item.active .tab-text {
  color: #409EFF;
  font-weight: 500;
  font-size: 26rpx;
}

/* 指示器 */
.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 20%;
  height: 4rpx;
  background: linear-gradient(90deg, #409EFF, #66b1ff);
  transition: left 0.3s ease;
  border-radius: 2rpx;
}

/* 连续内容区域 */
.continuous-content {
  padding: 20rpx;
}

/* 内容区域 */
.content-section {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 区域头部 */
.section-header {
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #303133;
}

/* 设施网格 */
.facilities-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.facility-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
  border-radius: 12rpx;
  background-color: #f8f9fa;
  transition: all 0.3s;
}

.facility-item:active {
  transform: scale(0.95);
}

.facility-item.available {
  background-color: #f0f9ff;
  border: 1rpx solid #409eff;
}

.facility-item.unavailable {
  opacity: 0.4;
}

.facility-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.facility-name {
  font-size: 22rpx;
  color: #606266;
}

/* 介绍内容 */
.description-content {
  font-size: 28rpx;
  color: #606266;
  line-height: 1.8;
  padding: 20rpx 0;
}

/* 预订提示 */
.booking-tips {
  padding: 10rpx 0;
}

.tip-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 10rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-icon {
  color: #67C23A;
  font-weight: bold;
  margin-right: 12rpx;
  font-size: 28rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #606266;
}

/* 评价区域 */
.reviews-section {
  padding: 10rpx 0;
}

.review-item {
  margin-bottom: 40rpx;
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid #eee;
}

.review-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.user-name-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-name {
  font-weight: 600;
  margin-bottom: 6rpx;
  color: #303133;
}

.user-rating {
  display: flex;
  align-items: center;
}

.star {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.rating-value {
  font-size: 22rpx;
  color: #666;
}

.review-content {
  color: #606266;
  line-height: 1.7;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.review-image {
  width: 160rpx;
  height: 160rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

.review-time-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stay-time {
  display: flex;
  align-items: center;
}

.time-label {
  font-size: 22rpx;
  color: #999;
}

.time-value {
  font-size: 22rpx;
  color: #666;
  font-weight: 500;
}

.review-time {
  color: #C0C4CC;
  font-size: 24rpx;
}

.empty-reviews {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 周边内容 */
.surrounding-content {
  padding: 20rpx 0;
}

.surrounding-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.surrounding-item:last-child {
  border-bottom: none;
}

.surrounding-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.surrounding-info {
  flex: 1;
}

.surrounding-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 6rpx;
}

.surrounding-desc {
  display: block;
  font-size: 24rpx;
  color: #909399;
}

/* 评分和销量样式 */
.room-stats {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.rating-tag {
  display: flex;
  align-items: center;
  background-color: #fff9e6;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  border: 1rpx solid #ffd700;
}

.star-icon {
  color: #FFD700;
  font-size: 22rpx;
  margin-right: 4rpx;
}

.rating-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  margin-right: 6rpx;
}

.rating-desc {
  font-size: 22rpx;
  color: #ff6b35;
  font-weight: 500;
}

.sales-tag {
  background-color: #f0f9ff;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  border: 1rpx solid #409eff;
}

.sales-count {
  font-size: 22rpx;
  font-weight: 500;
  color: #409eff;
}

.room-basic .room-tags {
  display: flex;
  flex-wrap: wrap;
}

.room-basic .tag {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.room-price-box {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 20rpx;
}

.price-wrapper {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.price-label {
  font-size: 22rpx;
  color: #909399;
  margin-right: 8rpx;
}

.price {
  font-size: 44rpx;
  color: #FF6B35;
  font-weight: 700;
}

.original-price-wrapper {
  display: flex;
  align-items: center;
}

.original-label {
  font-size: 20rpx;
  color: #C0C4CC;
  margin-right: 6rpx;
}

.original-price {
  font-size: 24rpx;
  color: #C0C4CC;
  text-decoration: line-through;
  margin-right: 10rpx;
}

.discount-tag {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
}

/* 房型亮点 */
.room-highlights {
  display: flex;
  flex-wrap: wrap;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.highlight-item {
  display: flex;
  align-items: center;
  margin-right: 30rpx;
  margin-bottom: 12rpx;
}

.highlight-icon {
  color: #67C23A;
  font-weight: bold;
  margin-right: 8rpx;
  font-size: 24rpx;
}

.highlight-text {
  font-size: 26rpx;
  color: #606266;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 999;
}

.action-left {
  display: flex;
  flex: 1;
}

.action-item {
  display: flex;
  flex-direction: row; /* 改为水平排列 */
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
  min-width: 120rpx; /* 增加最小宽度以适应水平布局 */
}

.action-icon {
  font-size: 40rpx;
  margin-right: 8rpx; /* 改为右边距，适用于水平排列 */
}

.action-text {
  font-size: 20rpx; /* 减小字体大小以节省空间 */
  color: #606266;
  white-space: nowrap; /* 防止文字换行 */
  overflow: hidden;
  text-overflow: ellipsis;
}

.action-right {
  flex: 1.5;
}

.book-btn {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8E53 100%);
  color: white;
  border-radius: 50rpx;
  height: 90rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.4);
}

.book-btn.disabled {
  background: linear-gradient(135deg, #C0C4CC 0%, #909399 100%);
  box-shadow: none;
}

.btn-price {
  font-size: 32rpx;
  font-weight: 700;
}

.btn-text {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 返回顶部按钮 */
.back-to-top {
  position: fixed;
  right: 30rpx;
  bottom: 200rpx;
  width: 80rpx;
  height: 80rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  transition: all 0.3s ease;
}

.back-to-top:active {
  transform: scale(0.9);
  background: rgba(0, 0, 0, 0.8);
}

.back-to-top-icon {
  color: white;
  font-size: 32rpx;
  font-weight: bold;
}

