.page{min-height:100vh;background:#f5f7fa;padding:20rpx;box-sizing:border-box}.search{display:flex;align-items:center;background:#fff;border-radius:40rpx;padding:18rpx 26rpx;margin-bottom:20rpx}.search input{flex:1}.search text{color:#409eff}.card{display:flex;background:#fff;border-radius:16rpx;overflow:hidden;margin-bottom:20rpx;box-shadow:0 4rpx 14rpx rgba(0,0,0,.06)}.card image{width:230rpx;height:190rpx}.body{flex:1;padding:22rpx;display:flex;flex-direction:column;gap:14rpx}.name{font-size:32rpx;font-weight:600;color:#303133}.address{font-size:24rpx;color:#909399;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.price{font-size:28rpx;color:#f56c6c;font-weight:600}.rating{float:right;color:#e6a23c}.empty{text-align:center;color:#909399;padding:100rpx 0}.error-state{display:flex;flex-direction:column;align-items:center;gap:24rpx;color:#909399;padding:100rpx 20rpx;text-align:center}.error-state button{color:#409eff;border-color:#409eff;background:#fff}
