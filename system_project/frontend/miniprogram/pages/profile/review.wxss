.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  cursor: pointer;
}

.tab-item.active {
  color: #4facfe;
  background: linear-gradient(to right, #4facfe, #00f2fe);
  color: #fff;
  font-weight: bold;
}

.review-list {
  height: calc(100vh - 140rpx);
}

.review-item {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.room-info {
  flex: 1;
}

.room-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.rating {
  display: flex;
  align-items: center;
}

.star {
  font-size: 28rpx;
  color: #ddd;
  margin-right: 4rpx;
}

.star.active {
  color: #FFB400;
}

.rating-value {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

.review-status {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #fff;
}

.review-status.info {
  background-color: #909399;
}

.review-status.success {
  background-color: #67C23A;
}

.review-status.danger {
  background-color: #F56C6C;
}

.review-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.image-item {
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
}

.image-item:last-child {
  margin-right: 0;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.review-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #eee;
  padding-top: 20rpx;
}

.review-time {
  font-size: 24rpx;
  color: #999;
}

.review-actions {
  display: flex;
}

.action-btn {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  border-radius: 6rpx;
  margin-left: 20rpx;
  border: 1rpx solid #ddd;
  background: #fff;
  color: #666;
}

.action-btn.danger {
  color: #ff4757;
  border-color: #ff4757;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}