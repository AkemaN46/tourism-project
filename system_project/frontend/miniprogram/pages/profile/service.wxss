.container {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding: 30rpx;
}

.service-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.service-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.service-options {
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
}

.service-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.service-item:last-child {
  border-bottom: none;
}

.service-left {
  display: flex;
  align-items: center;
}

.service-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
}

.service-info {
  display: flex;
  flex-direction: column;
}

.service-info .service-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.service-info .service-desc {
  font-size: 24rpx;
  color: #999;
}

.service-arrow {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.5;
}

.hotline-section {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
}

.hotline-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.hotline-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #409EFF;
  margin-bottom: 20rpx;
}

.hotline-desc {
  font-size: 24rpx;
  color: #999;
}