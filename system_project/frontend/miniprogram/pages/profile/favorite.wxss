/* favorite.wxss */
.favorite-list {
  height: 100vh;
}

.room-item {
  margin: 20rpx;
  padding: 0;
  overflow: hidden;
}

.room-image {
  width: 100%;
  height: 300rpx;
}

.room-content {
  padding: 20rpx;
}

.room-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.room-name {
  font-size: 32rpx;
  font-weight: bold;
}

.room-price {
  color: #F56C6C;
  font-size: 30rpx;
  font-weight: bold;
}

.room-desc {
  color: #909399;
  font-size: 24rpx;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.room-tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  background-color: #ecf5ff;
  color: #409eff;
  font-size: 20rpx;
  padding: 5rpx 15rpx;
  border-radius: 30rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.room-actions {
  display: flex;
  padding: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action-btn {
  flex: 1;
  margin: 0 10rpx;
  font-size: 24rpx;
  padding: 15rpx 0;
  border-radius: 30rpx;
  background-color: white;
  border: 1rpx solid #dcdfe6;
}

.action-btn.primary {
  background-color: #409EFF;
  color: white;
  border: 1rpx solid #409EFF;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  color: #909399;
  font-size: 28rpx;
}