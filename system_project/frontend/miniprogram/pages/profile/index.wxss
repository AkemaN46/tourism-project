.container {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 用户头部 */
.user-header {
  position: relative;
  margin: 30rpx 30rpx 10rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
}

.user-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
}

.user-info-content {
  position: relative;
  padding: 36rpx 28rpx;
  display: flex;
  align-items: center;
  z-index: 2;
}

.user-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.4);
  margin-right: 20rpx;
}

.user-details {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.user-id {
  display: block;
  font-size: 22rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.user-tags {
  display: flex;
}

.user-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

.vip-tag {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #fff;
}

.member-tag {
  background-color: #e3f2fd;
  color: #2196f3;
}

.user-arrow {
  width: 40rpx;
  height: 40rpx;
}

.user-arrow image {
  width: 100%;
  height: 100%;
}

/* 快捷数据 */
.quick-stats {
  display: flex;
  margin: 10rpx 30rpx 30rpx;
  padding: 28rpx 0;
  background-color: #fff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #f5f5f5;
}

.stat-item:last-child {
  border-right: none;
}

.stat-value {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* 菜单区域 */
.menu-section {
  margin: 0 30rpx 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30rpx;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.menu-icon {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 16rpx;
}

.menu-icon image {
  width: 100%;
  height: 100%;
}

.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 36rpx;
  height: 36rpx;
  background-color: #F56C6C;
  color: #fff;
  font-size: 22rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.menu-text {
  font-size: 24rpx;
  color: #666;
}

/* 工具服务 */
.tools-section {
  margin: 0 30rpx 30rpx;
}

.tools-list {
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
}

.tool-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.tool-item:last-child {
  border-bottom: none;
}

.tool-left {
  display: flex;
  align-items: center;
}

.tool-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.tool-text {
  font-size: 28rpx;
  color: #333;
}

.tool-arrow {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.5;
}

/* 退出登录 */
.logout-section {
  margin: 0 30rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #fff;
  color: #F56C6C;
  font-size: 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
}

.logout-btn::after {
  border: none;
}

/* 登录提示 */
.login-tip {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #999;
}