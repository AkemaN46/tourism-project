.container {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding: 20rpx;
}

.card {
  background-color: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 钱包余额卡片 */
.balance-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  padding: 40rpx;
}

.balance-header {
  margin-bottom: 40rpx;
}

.balance-label {
  display: block;
  font-size: 28rpx;
  opacity: 0.8;
  margin-bottom: 10rpx;
}

.balance-amount {
  font-size: 60rpx;
  font-weight: bold;
}

.balance-actions {
  display: flex;
  gap: 20rpx;
}

.balance-btn {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  border-radius: 30rpx;
  border: none;
}

.recharge-btn {
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.withdraw-btn {
  background-color: #fff;
  color: #667eea;
}

/* 资产卡片 */
.assets-card {
  display: flex;
  justify-content: space-around;
}

.asset-item {
  text-align: center;
}

.asset-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.asset-label {
  font-size: 24rpx;
  color: #999;
}

/* 交易记录卡片 */
.transaction-card {
  padding: 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.view-all {
  font-size: 24rpx;
  color: #667eea;
}

.transaction-list {
  padding: 0;
}

.empty-state {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.transaction-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.transaction-item:last-child {
  border-bottom: none;
}

.transaction-info {
  flex: 1;
}

.transaction-desc {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.transaction-time {
  font-size: 22rpx;
  color: #999;
}

.transaction-amount {
  font-size: 28rpx;
  font-weight: bold;
}

.positive {
  color: #67c23a;
}

.negative {
  color: #f56c6c;
}