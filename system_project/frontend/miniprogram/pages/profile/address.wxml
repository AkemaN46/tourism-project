<view class="container">
  <view class="address-list">
    <view 
      class="address-item" 
      wx:for="{{addresses}}" 
      wx:key="id"
    >
      <view class="address-info">
        <view class="address-header">
          <text class="address-name">{{item.name}}</text>
          <text class="address-phone">{{item.phone}}</text>
          <text class="default-tag" wx:if="{{item.isDefault}}">默认</text>
        </view>
        <view class="address-detail">{{item.address}}</view>
      </view>
      <view class="address-actions">
        <button class="set-default-btn" wx:if="{{!item.isDefault}}" bindtap="setDefault" data-id="{{item.id}}">设为默认</button>
        <button class="edit-btn" bindtap="editAddress" data-id="{{item.id}}">编辑</button>
      </view>
    </view>

    <view class="empty-state" wx:if="{{addresses.length === 0}}">
      <text>暂无收货地址</text>
    </view>
  </view>

  <button class="add-address-btn" bindtap="addAddress">+ 新增收货地址</button>
</view>