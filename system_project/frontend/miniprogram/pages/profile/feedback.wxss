.container {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding: 20rpx;
}

.card {
  background-color: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 反馈类型选择 */
.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.type-item {
  padding: 15rpx 30rpx;
  border: 2rpx solid #e4e7ed;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #606266;
}

.type-item.selected {
  border-color: #667eea;
  background-color: #f0f9ff;
  color: #667eea;
}

/* 反馈内容输入 */
.content-input {
  width: 100%;
  height: 200rpx;
  border: 2rpx solid #e4e7ed;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #303133;
  box-sizing: border-box;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: #909399;
  margin-top: 10rpx;
}

/* 联系方式输入 */
.contact-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e4e7ed;
  border-radius: 20rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #303133;
  box-sizing: border-box;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  border-radius: 20rpx;
  border: none;
  margin-top: 40rpx;
}