.container {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding: 20rpx;
}

.card {
  background-color: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 积分卡片 */
.points-card {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 50%, #fecfef 100%);
  color: #fff;
  padding: 40rpx;
}

.points-header {
  margin-bottom: 40rpx;
}

.points-label {
  display: block;
  font-size: 28rpx;
  opacity: 0.8;
  margin-bottom: 10rpx;
}

.points-total {
  font-size: 60rpx;
  font-weight: bold;
}

.points-actions {
  display: flex;
  gap: 20rpx;
}

.points-btn {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  border-radius: 30rpx;
  border: none;
}

.exchange-btn {
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.rules-btn {
  background-color: #fff;
  color: #ff6b6b;
}

/* 历史记录卡片 */
.history-card {
  padding: 0;
}

.section-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.history-list {
  padding: 0;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.history-item:last-child {
  border-bottom: none;
}

.history-info {
  flex: 1;
}

.history-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.history-date {
  font-size: 22rpx;
  color: #999;
}

.history-points {
  font-size: 28rpx;
  font-weight: bold;
}

.positive {
  color: #67c23a;
}

.negative {
  color: #f56c6c;
}

.empty-state {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}