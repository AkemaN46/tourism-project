/* info.wxss */
.form-section {
  background-color: white;
  margin: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 150rpx;
  font-size: 28rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  padding: 10rpx 0;
}

.picker {
  flex: 1;
  font-size: 28rpx;
  padding: 10rpx 0;
  text-align: right;
  color: #909399;
}

.avatar-wrapper {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.submit-section {
  padding: 20rpx;
}

.submit-btn {
  background-color: #409EFF;
  color: white;
  font-size: 32rpx;
  padding: 20rpx 0;
  border-radius: 50rpx;
}