/* pages/login/index.wxss */
.container {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.login-box {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 80rpx 60rpx;
  width: 100%;
  max-width: 600rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
  border-radius: 50%;
  background-color: #f5f7fa;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #303133;
  margin-bottom: 16rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #909399;
  margin-bottom: 80rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07c160 0%, #05a350 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-bottom: 40rpx;
}

.login-btn::after {
  border: none;
}

.wx-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}

.login-btn text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
}

.agreement {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
  font-size: 24rpx;
  color: #606266;
}

.agree-text {
  margin-left: 8rpx;
}

.link {
  color: #409eff;
  margin: 0 4rpx;
}
