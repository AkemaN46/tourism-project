<view class="container">
  <!-- 民宿信息 -->
  <view class="room-card card">
    <image src="{{order.roomImage}}" class="room-image"></image>
    <view class="room-info">
      <text class="room-name">{{order.roomName}}</text>
      <text class="order-time">{{order.checkInDate}} 至 {{order.checkOutDate}}</text>
    </view>
  </view>

  <!-- 评分区域 -->
  <view class="section card">
    <view class="section-title">整体评价</view>
    <view class="rating-container">
      <view class="rating-stars">
        <block wx:for="{{[1, 2, 3, 4, 5]}}" wx:key="index">
          <view class="star" 
                data-rating="{{item}}" 
                bindtap="onRateChange"
                style="color: {{item <= rating ? '#FFB400' : '#E5E5E5'}}">
            ★
          </view>
        </block>
      </view>
      <text class="rating-text">{{rating}}星好评</text>
    </view>
  </view>

  <!-- 评价内容 -->
  <view class="section card">
    <view class="section-title">评价内容</view>
    <textarea class="content-input" 
              placeholder="分享入住体验，最多 500 字" 
              value="{{content}}"
              bindinput="onContentInput"
              maxlength="500"></textarea>
    <view class="word-count">{{content.length}}/500</view>
  </view>

  <!-- 图片上传 -->
  <view class="section card">
    <view class="section-title">晒图评价（可选）</view>
    <view class="image-upload">
      <view class="image-item" wx:for="{{images}}" wx:key="index">
        <image src="{{item.url}}" 
               class="uploaded-image" 
               mode="aspectFill"
               bindtap="previewImage" 
               data-index="{{index}}"></image>
        <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}">×</view>
      </view>
      
      <view class="upload-btn" 
            wx:if="{{images.length < maxImages}}" 
            bindtap="chooseImage">
        <text class="upload-icon">+</text>
        <text class="upload-text">添加图片</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="submit-btn" bindtap="submitReview" disabled="{{uploading}}">
      {{uploading ? '提交中...' : '提交评价'}}
    </button>
  </view>
</view>
