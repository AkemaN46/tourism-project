<view class="container">
  <!-- 订单状态筛选 -->
  <view class="status-tabs">
    <view class="tab-item {{!currentStatus ? 'active' : ''}}" bindtap="switchStatus" data-status="">全部</view>
    <view class="tab-item {{currentStatus == 0 ? 'active' : ''}}" bindtap="switchStatus" data-status="0">待支付</view>
    <view class="tab-item {{currentStatus == 1 ? 'active' : ''}}" bindtap="switchStatus" data-status="1">已支付</view>
    <view class="tab-item {{currentStatus == 2 ? 'active' : ''}}" bindtap="switchStatus" data-status="2">已入住</view>
    <view class="tab-item {{currentStatus == 3 ? 'active' : ''}}" bindtap="switchStatus" data-status="3">已完成</view>
  </view>

  <!-- 订单列表 -->
  <scroll-view class="order-list" scroll-y>
    <view class="order-item card" wx:for="{{orderList}}" wx:key="id">
      <view class="order-header">
        <text class="order-no">订单号: {{item.orderNo}}</text>
        <text class="order-status {{getStatusClass(item.status)}}">{{getStatusText(item.status)}}</text>
      </view>
      <view class="order-content" bindtap="goToDetail" data-id="{{item.id}}">
        <image src="{{item.roomImage}}" class="room-image" mode="aspectFill" binderror="onRoomImageError" data-index="{{index}}"></image>
        <view class="room-info">
          <text class="room-name">{{item.roomName}}</text>
          <text class="stay-time">入住：{{item.checkInDate}} 14:00</text>
          <text class="stay-time">离店：{{item.checkOutDate}} 12:00</text>
          <text class="stay-nights">(共{{item.nights}}晚)</text>
          <text class="contact">联系人：{{item.contactName}}</text>
        </view>
        <view class="order-price">
          <text class="price">¥{{item.totalAmount}}</text>
        </view>
      </view>
      <view class="order-footer">
        <text class="order-time">{{item.createdAt}}</text>
        <view class="order-actions">
          <button class="action-btn" wx:if="{{item.status === 0}}" bindtap="cancelOrder" data-id="{{item.id}}">取消订单</button>
          <button class="action-btn primary" wx:if="{{item.status === 0}}" bindtap="payOrder" data-id="{{item.id}}">去支付</button>
          <button class="action-btn" wx:if="{{item.status === 3 && !item.reviewed}}" bindtap="reviewOrder" data-id="{{item.id}}">去评价</button>
          <text class="reviewed-tag" wx:if="{{item.status === 3 && item.reviewed}}">已评价</text>
        </view>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{orderList.length === 0 && !loading}}">
      <image src="/assets/icons/empty.png" class="empty-icon"></image>
      <text class="empty-text">暂无{{currentStatus === '' ? '全部' : getStatusText(Number(currentStatus))}}订单</text>
    </view>
  </scroll-view>
</view>
