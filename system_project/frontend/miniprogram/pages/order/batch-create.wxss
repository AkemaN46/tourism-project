.container {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding: 30rpx;
}

.order-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.order-list {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
}

.order-item {
  margin-bottom: 30rpx;
}

.order-item:last-child {
  margin-bottom: 0;
}

.room-info {
  display: flex;
  align-items: center;
}

.room-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.room-details {
  flex: 1;
}

.room-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.room-date {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.room-price {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #F56C6C;
}

.price-summary {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.total-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #F56C6C;
}

.pay-section {
  padding: 0 30rpx;
}

.pay-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #409EFF, #337ECC);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
}

.pay-btn::after {
  border: none;
}

/* 联系人信息样式 */
.section-title {
  margin: 30rpx 0 20rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.form-section {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #f5f7fa;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 50rpx;
  max-height: 50rpx;
  background-color: #f5f7fa;
  border-radius: 10rpx;
  padding: 10rpx 15rpx; 
  font-size: 24rpx; 
  color: #333;
  box-sizing: border-box;
  line-height: 1.2;
}