/* list.wxss */
.status-tabs {
  display: flex;
  background-color: white;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 15rpx 0;
  font-size: 28rpx;
}

.tab-item.active {
  color: #409EFF;
  font-weight: bold;
  border-bottom: 4rpx solid #409EFF;
}

.order-list {
  height: calc(100vh - 200rpx);
}

.order-item {
  margin: 20rpx;
  padding: 0;
  overflow: hidden;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-no {
  font-size: 24rpx;
  color: #909399;
}

.order-status {
  font-size: 24rpx;
}

.order-status.info {
  color: #909399;
}

.order-status.warning {
  color: #E6A23C;
}

.order-status.primary {
  color: #409EFF;
}

.order-status.success {
  color: #67C23A;
}

.order-content {
  display: flex;
  padding: 20rpx;
}

.room-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.room-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.room-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.stay-time {
  font-size: 24rpx;
  color: #909399;
  margin-bottom: 5rpx;
}

.stay-nights {
  font-size: 24rpx;
  color: #606266;
  font-weight: 500;
  margin-bottom: 5rpx;
}

.contact {
  font-size: 24rpx;
  color: #909399;
  margin-bottom: 5rpx;
}

.order-price {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
}

.price {
  font-size: 32rpx;
  color: #F56C6C;
  font-weight: bold;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.order-time {
  font-size: 24rpx;
  color: #909399;
}

.order-actions {
  display: flex;
}

.action-btn {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  margin-left: 20rpx;
  border-radius: 30rpx;
  background-color: white;
  border: 1rpx solid #dcdfe6;
}

.action-btn.primary {
  background-color: #409EFF;
  color: white;
  border: 1rpx solid #409EFF;
}

/* 已评价标签 */
.reviewed-tag {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  margin-left: 20rpx;
  border-radius: 30rpx;
  background-color: #67C23A;
  color: white;
  border: 1rpx solid #67C23A;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  color: #909399;
  font-size: 28rpx;
}