/* create.wxss */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  padding: 20rpx;
  display: flex;
  align-items: center;
}

.section-title .subtitle {
  font-size: 24rpx;
  color: #909399;
  margin-left: 16rpx;
  font-weight: normal;
}

/* 日期信息卡片 */
.date-info-card {
  margin: 0 20rpx 30rpx;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f5f9ff 100%);
  border: 2rpx solid #e6f0ff;
  box-shadow: 0 4rpx 20rpx rgba(64, 158, 255, 0.1);
}

.date-info-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.date-info-item {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.date-info-item.left {
  align-items: flex-start;
}

.date-info-item.right {
  align-items: flex-end;
}

.date-label {
  font-size: 24rpx;
  color: #909399;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.date-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #303133;
  margin-bottom: 8rpx;
}

.date-week {
  font-size: 24rpx;
  color: #409EFF;
  font-weight: 600;
  background: rgba(64, 158, 255, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.date-nights {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx;
  position: relative;
}

.date-nights::before {
  content: '';
  position: absolute;
  top: 50%;
  left: -20rpx;
  right: -20rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #409EFF, transparent);
  transform: translateY(-50%);
}

.nights-box {
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(168, 237, 234, 0.3);
  position: relative;
  z-index: 1;
}

.nights-count {
  font-size: 24rpx;
  color: #2d3436;
  font-weight: 700;
}

.arrow-hint {
  font-size: 22rpx;
  color: #909399;
  font-weight: 500;
}

/* 日期选择弹窗 */
.date-picker-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.popup-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.popup-content {
  position: relative;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.popup-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #303133;
}

.popup-close {
  font-size: 48rpx;
  color: #909399;
  padding: 0 20rpx;
}

/* 月份切换 */
.month-switcher {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 20rpx;
  flex-shrink: 0;
}

.switch-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f7fa;
  border-radius: 50%;
}

.switch-btn.disabled {
  opacity: 0.3;
}

.switch-btn .arrow {
  font-size: 28rpx;
  color: #303133;
}

.current-month {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
}

/* 星期标题 */
.popup-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.popup-weekdays .weekday {
  text-align: center;
  font-size: 26rpx;
  color: #909399;
}

/* 弹窗日历 */
.popup-calendar-scroll {
  flex: 1;
  overflow-y: auto;
  max-height: 450rpx;
  margin-bottom: 20rpx;
}

.popup-calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.popup-calendar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 4rpx;
  border-radius: 12rpx;
  background-color: #f8f9fa;
  min-height: 100rpx;
}

.popup-calendar-item.empty {
  background-color: transparent;
  pointer-events: none;
}

.popup-calendar-item.full {
  background-color: #fef0f0;
  opacity: 0.5;
  pointer-events: none;
}

.popup-calendar-item.selected {
  background-color: #409EFF;
}

.popup-calendar-item.start-date {
  background-color: #409EFF;
  border-radius: 12rpx 0 0 12rpx;
}

.popup-calendar-item.end-date {
  background-color: #409EFF;
  border-radius: 0 12rpx 12rpx 0;
}

.popup-calendar-item.start-date.end-date {
  border-radius: 12rpx;
}

.popup-calendar-item.selected .popup-day,
.popup-calendar-item.start-date .popup-day,
.popup-calendar-item.end-date .popup-day,
.popup-calendar-item.selected .popup-price,
.popup-calendar-item.start-date .popup-price,
.popup-calendar-item.end-date .popup-price {
  color: #fff;
}

.popup-calendar-item.selected .popup-holiday,
.popup-calendar-item.start-date .popup-holiday,
.popup-calendar-item.end-date .popup-holiday {
  color: #fff;
}

.popup-calendar-item.in-range {
  background-color: #e6f7ff;
}

.popup-day {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
}

.popup-holiday {
  font-size: 18rpx;
  color: #FF6B6B;
  margin-top: 4rpx;
}

.popup-price {
  font-size: 20rpx;
  color: #FF6B35;
  margin-top: 4rpx;
}

.popup-status {
  font-size: 18rpx;
  color: #F56C6C;
  margin-top: 4rpx;
}

/* 弹窗底部 */
.popup-footer {
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
  background-color: #fff;
  z-index: 10;
}

.selected-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.selected-date {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.selected-date-row {
  margin-bottom: 8rpx;
}

.date-text {
  font-size: 26rpx;
  color: #303133;
}

.separator {
  font-size: 28rpx;
  color: #909399;
  margin: 0 16rpx;
}

.nights-text {
  font-size: 26rpx;
  color: #409EFF;
  font-weight: 600;
}

.confirm-btn {
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
  color: #2d3436;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 12rpx rgba(168, 237, 234, 0.4);
  cursor: pointer;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-btn.disabled {
  background: linear-gradient(135deg, #e0e0e0 0%, #f5f5f5 100%);
  color: #9e9e9e;
  box-shadow: none;
  opacity: 0.7;
}

.date-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.date-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
}

.date-label {
  display: block;
  font-size: 24rpx;
  color: #909399;
  margin-bottom: 10rpx;
}

.date-value {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
}

.date-separator {
  font-size: 24rpx;
  color: #909399;
}

.room-info {
  display: flex;
  padding: 20rpx;
  margin: 0 20rpx 20rpx;
}

.room-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.room-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.room-name {
  font-size: 32rpx;
  font-weight: bold;
}

.room-price {
  color: #F56C6C;
  font-size: 28rpx;
  font-weight: bold;
}

.form-section {
  margin: 0 20rpx 20rpx;
  padding: 20rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  margin-bottom: 15rpx;
}

.input {
  border: 1rpx solid #dcdfe6;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.textarea {
  border: 1rpx solid #dcdfe6;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 28rpx;
  height: 150rpx;
  width: 100%;
  box-sizing: border-box;
}

.price-details {
  margin: 0 20rpx 20rpx;
  padding: 20rpx;
}

.price-item {
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.price-item:last-child {
  border-bottom: none;
}

.price-item.total {
  font-weight: bold;
  font-size: 32rpx;
  margin-top: 20rpx;
}

.total-price {
  color: #F56C6C;
}

.submit-section {
  padding: 20rpx;
}

.submit-btn {
  background-color: #409EFF;
  color: white;
  font-size: 32rpx;
  padding: 20rpx 0;
  border-radius: 50rpx;
}