/* detail.wxss */
.order-status-card {
  margin: 20rpx;
  padding: 30rpx;
  text-align: center;
}

.status-header {
  margin-bottom: 20rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
}

.status-text.info {
  color: #909399;
}

.status-text.warning {
  color: #E6A23C;
}

.status-text.primary {
  color: #409EFF;
}

.status-text.success {
  color: #67C23A;
}

.status-text.danger {
  color: #F56C6C;
}

.status-desc {
  color: #909399;
  font-size: 28rpx;
}

.room-info {
  display: flex;
  margin: 20rpx;
  padding: 20rpx;
}

.room-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.room-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.room-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.stay-time {
  font-size: 24rpx;
  color: #909399;
  margin-bottom: 5rpx;
}

.stay-nights {
  font-size: 24rpx;
  color: #606266;
  font-weight: 500;
  margin-bottom: 5rpx;
}

.contact {
  font-size: 24rpx;
  color: #909399;
  margin-bottom: 5rpx;
}

.price-details {
  margin: 20rpx;
  padding: 20rpx;
}

.price-item {
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.price-item:last-child {
  border-bottom: none;
}

.price-item.total {
  font-weight: bold;
  font-size: 32rpx;
}

.total-price {
  color: #F56C6C;
}

.order-info {
  margin: 20rpx;
  padding: 20rpx;
}

.info-item {
  display: flex;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.label {
  width: 150rpx;
  color: #909399;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: white;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.action-btn {
  flex: 1;
  margin: 0 10rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-radius: 50rpx;
  background-color: white;
  border: 1rpx solid #dcdfe6;
}

.action-btn.primary {
  background-color: #409EFF;
  color: white;
  border: 1rpx solid #409EFF;
}

/* 已评价标签 */
.reviewed-tag {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 20rpx 0;
  margin: 0 10rpx;
  border-radius: 50rpx;
  background-color: #67C23A;
  color: white;
  font-weight: bold;
}