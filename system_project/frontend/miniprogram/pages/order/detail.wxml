<view class="container">
  <!-- 订单状态 -->
  <view class="order-status-card card">
    <view class="status-header">
      <text class="status-text {{getStatusClass(order.status)}}">{{getStatusText(order.status)}}</text>
    </view>
    <view class="status-desc">
      <text>{{getStatusDesc(order.status)}}</text>
    </view>
  </view>

  <!-- 民宿信息 -->
  <view class="room-info card">
    <image src="{{order.roomImage}}" class="room-image"></image>
    <view class="room-details">
      <text class="room-name">{{order.roomName}}</text>
      <text class="stay-time">入住：{{order.checkInDate}} 14:00</text>
      <text class="stay-time">离店：{{order.checkOutDate}} 12:00</text>
      <text class="stay-nights">(共{{order.nights}}晚)</text>
      <text class="contact">联系人: {{order.contactName}} ({{order.contactPhone}})</text>
    </view>
  </view>

  <!-- 价格明细 -->
  <view class="price-details card">
    <view class="price-item">
      <text>单价</text>
      <text>¥{{order.price}}/晚</text>
    </view>
    <view class="price-item">
      <text>入住晚数</text>
      <text>{{order.nights}}晚</text>
    </view>
    <view class="price-item total">
      <text>总计</text>
      <text class="total-price">¥{{order.totalAmount}}</text>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="order-info card">
    <view class="info-item">
      <text class="label">订单号:</text>
      <text>{{order.orderNo}}</text>
    </view>
    <view class="info-item">
      <text class="label">下单时间:</text>
      <text>{{order.createdAt}}</text>
    </view>
    <view class="info-item" wx:if="{{order.paymentTime}}">
      <text class="label">支付时间:</text>
      <text>{{order.paymentTime}}</text>
    </view>
    <view class="info-item" wx:if="{{order.remark}}">
      <text class="label">备注:</text>
      <text>{{order.remark}}</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <button class="action-btn" wx:if="{{order.status === 0}}" bindtap="cancelOrder">取消订单</button>
    <button class="action-btn primary" wx:if="{{order.status === 0}}" bindtap="payOrder">去支付</button>
    <button class="action-btn" wx:if="{{order.status === 3 && !order.reviewed}}" bindtap="goToReview">去评价</button>
    <text class="reviewed-tag" wx:if="{{order.status === 3 && order.reviewed}}">已评价</text>
  </view>
</view>