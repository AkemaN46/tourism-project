<view class="page">
  <view class="title">民宿（{{homestays.length}}）</view>
  <view class="item" wx:for="{{homestays}}" wx:key="id" bindtap="openHomestay" data-id="{{item.id}}">
    <image src="{{item.coverImage}}" mode="aspectFill"/><view><text class="name">{{item.name}}</text><text>{{item.address}}</text></view>
  </view>
  <view class="title">房型（{{rooms.length}}）</view>
  <view class="item" wx:for="{{rooms}}" wx:key="id" bindtap="openRoom" data-id="{{item.id}}">
    <image src="{{item.coverImage}}" mode="aspectFill"/><view><text class="name">{{item.name}}</text><text>{{item.homestayName}}</text><text class="price">¥{{item.price}}/晚</text></view>
  </view>
  <view class="empty" wx:if="{{!loading && homestays.length === 0 && rooms.length === 0}}">未找到相关民宿或房型</view>
</view>
