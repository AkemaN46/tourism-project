        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&quot;HTTP=&quot; + prev.getResponseCode() + &quot;, JSON code=&quot; + json?.code)
    }
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;响应不是可解析的 JSON：&quot; + e.message)
}</stringProp>
